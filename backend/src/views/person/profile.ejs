<%- include('../partials/top') %>

<div class="profile-header">
  <div class="profile-photo-wrap">
    <div class="profile-photo">
      <% if (person.imageUrl) { %><img src="<%= person.imageUrl %>" alt=""><% } else { %>&#128100;<% } %>
    </div>
    <span class="photo-upload-badge" title="Upload photo">&#8593;</span>
  </div>
  <div>
    <div class="profile-name"><%= person.firstName %> <%= person.lastName %> <span class="text-muted">#<%= person.id %></span></div>
    <div class="profile-meta">
      <span class="dept-mini-icon">&#127963;</span>
      <%= person.departmentName || 'Civilian' %>
      <% if (person.rankTitle) { %> &middot; <%= person.rankTitle %> <% } %>
      <% if (person.badgeNumber) { %><span class="badge-id">#<%= person.badgeNumber %></span><% } %>
    </div>
    <details class="actions-dropdown">
      <summary class="btn btn-sm">Actions &#9662;</summary>
      <div class="dropdown-menu">
        <% if (currentUser && currentUser.role === 'admin') { %>
          <a href="/admin/people/<%= person.id %>/edit">Edit Profile</a>
        <% } %>
        <a href="/person/<%= person.id %>/infractions/new">Create Infraction Report</a>
        <a href="/person/<%= person.id %>/citations/new">Issue Citation</a>
        <a href="/dmv?q=<%= encodeURIComponent(person.lastName) %>">View Vehicles</a>
        <a href="/wanted">View Wanted Database</a>
      </div>
    </details>
  </div>
  <div class="profile-age">Age: <%= person.age || '—' %></div>
</div>

<% if (person.wantedEntry && person.wantedEntry.active) { %>
<div class="panel" style="border:1px solid var(--danger);">
  <div class="panel-header" style="color:var(--danger);"><span class="collapse-dot" style="background:var(--danger);">!</span> Active Wanted Entry</div>
  <div class="panel-body">
    <strong><%= person.wantedEntry.dangerLevel %> Priority</strong> &mdash; <%= person.wantedEntry.reason %>
    <div class="text-muted">Posted by <%= person.wantedEntry.postedBy %> on <%= person.wantedEntry.postedAt.toDateString() %></div>
  </div>
</div>
<% } %>

<%
  const activeWarrants = person.arrestWarrants.filter(w => w.status === 'Active');
  const oldWarrants = person.arrestWarrants.filter(w => w.status !== 'Active');
  const unpaidCitations = person.citations.filter(c => c.status !== 'Paid');
  const paidCitations = person.citations.filter(c => c.status === 'Paid');
%>

<div class="profile-columns">
  <div class="profile-col">
    <div class="panel">
      <div class="panel-header"><span class="collapse-dot">&minus;</span> <span class="panel-icon">&#128100;</span> Profiling Samples</div>
      <div class="panel-body">
        <div class="sample-row">&#129509; Fingerprints <span class="sample-status">On File</span></div>
        <div class="sample-row">&#129516; DNA <span class="sample-status not-set">Not Set</span></div>
      </div>
    </div>

    <div class="panel">
      <div class="panel-header"><span class="collapse-dot">&minus;</span> <span class="panel-icon">&#128663;</span> Registered Vehicles</div>
      <div class="panel-body <%= person.vehicles.length ? '' : 'empty' %>">
        <% if (!person.vehicles.length) { %>No Registered Vehicles<% } else { %>
          <% person.vehicles.forEach(function(v){ %>
            <div class="mini-row">
              <span class="veh-dot <%= v.registered ? 'ok' : 'bad' %>" title="<%= v.registered ? 'Registered' : 'Unregistered' %>"></span>
              <span class="veh-dot <%= v.insured ? 'ok' : 'bad' %>" title="<%= v.insured ? 'Insured' : (v.insuranceExpiredAt ? 'Insurance expired ' + new Date(v.insuranceExpiredAt).toDateString() : 'Uninsured') %>"></span>
              <strong><a href="/dmv/<%= v.id %>"><%= v.color %> <%= v.model %></a></strong><br>
              <span class="text-muted"><%= v.plate %> &middot; #<%= v.vin %></span>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>

    <div class="panel">
      <div class="panel-header"><span class="collapse-dot">&minus;</span> <span class="panel-icon">&#8853;</span> Firearms Related Purchases</div>
      <div class="panel-body empty">No Firearm-Related Purchases</div>
    </div>
  </div>

  <div class="profile-col">
    <div class="panel">
      <div class="panel-header"><span class="collapse-dot">&minus;</span> <span class="panel-icon">&#9888;</span> Caution Codes</div>
      <div class="panel-body <%= person.cautionCodes.length ? '' : 'empty' %>">
        <% if (!person.cautionCodes.length) { %>Caution Codes Not Set<% } else { %>
          <% person.cautionCodes.forEach(function(c){ %>
            <div class="mini-row"><strong><%= c.code %></strong><% if (c.detail) { %> &mdash; <%= c.detail %><% } %></div>
          <% }); %>
        <% } %>
      </div>
    </div>

    <div class="panel">
      <div class="panel-header"><span class="collapse-dot">&minus;</span> <span class="panel-icon">&#9742;</span> Phones</div>
      <div class="panel-body <%= person.phones.length ? '' : 'empty' %>">
        <% if (!person.phones.length) { %>Phone Numbers Not Set<% } else { %>
          <% person.phones.forEach(function(ph){ %>
            <div class="mini-row">&#9742; <%= ph.number %> <% if (ph.label) { %><span class="text-muted">(<%= ph.label %>)</span><% } %></div>
          <% }); %>
        <% } %>
      </div>
    </div>

    <div class="panel">
      <div class="panel-header"><span class="collapse-dot">&minus;</span> <span class="panel-icon">&#127960;</span> Garages</div>
      <div class="panel-body <%= person.garages.length ? '' : 'empty' %>">
        <% if (!person.garages.length) { %>Unknown Garages<% } else { %>
          <% person.garages.forEach(function(g){ %>
            <div class="mini-row"><strong><%= g.name %></strong><br><span class="text-muted"><%= g.address %></span></div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>

  <div class="profile-col">
    <div class="panel">
      <div class="panel-header"><span class="collapse-dot">&minus;</span> <span class="panel-icon">&#128179;</span> Licenses</div>
      <div class="panel-body <%= person.licenses.length ? '' : 'empty' %>">
        <% if (!person.licenses.length) { %>No Licenses On File<% } else { %>
          <% person.licenses.forEach(function(l){ %>
            <div class="mini-row">
              <strong><%= l.type %></strong> (<%= l.region %>)<br>
              <span class="status-pill <%= l.status.toLowerCase() %>"><%= l.status %></span>
              <% if (l.validUntil) { %><span class="text-muted"> until <%= l.validUntil.toDateString() %></span><% } %>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>

    <div class="panel">
      <div class="panel-header"><span class="collapse-dot">&minus;</span> <span class="panel-icon">&#127968;</span> Residences</div>
      <div class="panel-body <%= person.residences.length ? '' : 'empty' %>">
        <% if (!person.residences.length) { %>Unknown Residences<% } else { %>
          <% person.residences.forEach(function(r){ %>
            <div class="mini-row">&#127968; <%= r.address %></div>
          <% }); %>
        <% } %>
      </div>
    </div>

    <div class="panel">
      <div class="panel-header"><span class="collapse-dot">&minus;</span> <span class="panel-icon">&#128188;</span> Businesses</div>
      <div class="panel-body <%= person.businesses.length ? '' : 'empty' %>">
        <% if (!person.businesses.length) { %>Unknown Businesses<% } else { %>
          <% person.businesses.forEach(function(b){ %>
            <div class="mini-row"><strong><%= b.name %></strong><% if (b.role) { %> &mdash; <%= b.role %><% } %></div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>
</div>

<div class="panel">
  <div class="panel-header"><span class="collapse-dot">&minus;</span> <span class="panel-icon">&#128196;</span> Arrest Warrants</div>
  <div class="panel-body <%= activeWarrants.length ? '' : 'empty' %>">
    <% if (!activeWarrants.length) { %>No data available in table.<% } else { %>
      <table class="data-table">
        <thead><tr><th>#</th><th>Classification</th><th>Charges</th><th>Filed By</th><th>Signed By</th><th>Status</th><% if (currentUser && currentUser.role === 'admin') { %><th></th><% } %></tr></thead>
        <tbody>
          <% activeWarrants.forEach(function(w){ %>
            <tr>
              <td>#<%= w.id %></td><td><%= w.classification %></td><td><%= w.charges %></td>
              <td><%= w.filedBy %></td><td><%= w.signedBy || '—' %></td>
              <td><span class="status-pill <%= w.status.toLowerCase() %>"><%= w.status %></span></td>
              <% if (currentUser && currentUser.role === 'admin') { %>
                <td><%- include('../partials/admin-delete-button', { resource: 'warrants', id: w.id, personId: person.id }) %></td>
              <% } %>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <%- include('../partials/table-footer', { count: activeWarrants.length }) %>
    <% } %>
  </div>
</div>

<div class="panel">
  <div class="panel-header"><span class="collapse-dot">&minus;</span> <span class="panel-icon">&#128220;</span> Warrant Records (Old)</div>
  <div class="panel-body <%= oldWarrants.length ? '' : 'empty' %>">
    <% if (!oldWarrants.length) { %>No data available in table.<% } else { %>
      <table class="data-table">
        <thead><tr><th>#</th><th>Classification</th><th>Charges</th><th>Status</th></tr></thead>
        <tbody>
          <% oldWarrants.forEach(function(w){ %>
            <tr>
              <td>#<%= w.id %></td><td><%= w.classification %></td><td><%= w.charges %></td>
              <td><span class="status-pill <%= w.status.toLowerCase() %>"><%= w.status %></span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <%- include('../partials/table-footer', { count: oldWarrants.length }) %>
    <% } %>
  </div>
</div>

<div class="panel">
  <div class="panel-header"><span class="collapse-dot">&minus;</span> <span class="panel-icon">&#127915;</span> Outstanding Citations</div>
  <div class="panel-body <%= unpaidCitations.length ? '' : 'empty' %>">
    <% if (!unpaidCitations.length) { %>No data available in table.<% } else { %>
      <table class="data-table">
        <thead><tr><th>#</th><th>Timestamp</th><th>Amount</th><th>Reason</th><th>Status</th><th>Cited By</th><% if (currentUser && currentUser.role === 'admin') { %><th></th><% } %></tr></thead>
        <tbody>
          <% unpaidCitations.forEach(function(c){ %>
            <tr>
              <td>#<%= c.id %></td><td><%= c.timestamp.toDateString() %></td><td>$<%= c.amount.toLocaleString() %></td>
              <td><%= c.reason %></td>
              <td><span class="status-pill <%= c.status.toLowerCase() %>"><%= c.status %></span></td>
              <td><%= c.issuedByFirstName ? c.issuedByFirstName + ' ' + c.issuedByLastName : '—' %></td>
              <% if (currentUser && currentUser.role === 'admin') { %>
                <td><%- include('../partials/admin-delete-button', { resource: 'citations', id: c.id, personId: person.id }) %></td>
              <% } %>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <%- include('../partials/table-footer', { count: unpaidCitations.length }) %>
    <% } %>
  </div>
</div>

<div class="panel">
  <div class="panel-header"><span class="collapse-dot">&minus;</span> <span class="panel-icon">&#9989;</span> Paid Citations</div>
  <div class="panel-body <%= paidCitations.length ? '' : 'empty' %>">
    <% if (!paidCitations.length) { %>No data available in table.<% } else { %>
      <table class="data-table">
        <thead><tr><th>#</th><th>Timestamp</th><th>Amount</th><th>Reason</th><th>Cited By</th><% if (currentUser && currentUser.role === 'admin') { %><th></th><% } %></tr></thead>
        <tbody>
          <% paidCitations.forEach(function(c){ %>
            <tr>
              <td>#<%= c.id %></td><td><%= c.timestamp.toDateString() %></td><td>$<%= c.amount.toLocaleString() %></td>
              <td><%= c.reason %></td>
              <td><%= c.issuedByFirstName ? c.issuedByFirstName + ' ' + c.issuedByLastName : '—' %></td>
              <% if (currentUser && currentUser.role === 'admin') { %>
                <td><%- include('../partials/admin-delete-button', { resource: 'citations', id: c.id, personId: person.id }) %></td>
              <% } %>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <%- include('../partials/table-footer', { count: paidCitations.length }) %>
    <% } %>
  </div>
</div>

<div class="panel">
  <div class="panel-header"><span class="collapse-dot">&minus;</span> <span class="panel-icon">&#8505;</span> Information Record</div>
  <div class="panel-body empty">No data available in table.</div>
</div>

<div class="panel">
  <div class="panel-header"><span class="collapse-dot">&minus;</span> <span class="panel-icon">&#128295;</span> Criminal Record</div>
  <div class="panel-body empty">No data available in table.</div>
</div>

<div class="panel">
  <div class="panel-header">
    <span class="collapse-dot">&minus;</span> <span class="panel-icon">&#8505;</span> Infraction Record
  </div>
  <div class="panel-body <%= person.infractions.length ? '' : 'empty' %>">
    <% if (!person.infractions.length) { %>No data available in table.<% } else { %>
      <table class="data-table">
        <thead><tr><th>#</th><th>Actions</th><th>Timestamp</th><th>Type</th><th>Remark</th><th>Status</th></tr></thead>
        <tbody>
          <% person.infractions.forEach(function(i){ %>
            <tr>
              <td>#<%= i.id %></td>
              <td>
                <% if (i.type === 'Infraction Report') { %>
                  <a class="action-icon" title="View Record" href="/person/<%= person.id %>/infractions/<%= i.id %>">&#128196;</a>
                  <a class="action-icon link" title="Issue Citation" href="/person/<%= person.id %>/citations/new?infractionId=<%= i.id %>">&#128279;</a>
                <% } else { %>
                  <span class="action-icon" style="opacity:.35;cursor:default;">&#128196;</span>
                <% } %>
                <% if (currentUser && currentUser.role === 'admin') { %>
                  <%- include('../partials/admin-delete-button', { resource: 'infractions', id: i.id, personId: person.id }) %>
                <% } %>
              </td>
              <td><%= i.timestamp.toDateString() %></td><td><%= i.type %></td>
              <td><%= i.remark %></td>
              <td><span class="status-pill <%= i.status.toLowerCase() %>"><%= i.status %></span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <%- include('../partials/table-footer', { count: person.infractions.length }) %>
    <% } %>
  </div>
</div>

<div class="panel">
  <div class="panel-header"><span class="collapse-dot">&minus;</span> <span class="panel-icon">&#128683;</span> Deleted Record</div>
  <div class="panel-body empty">No data available in table.</div>
</div>

<div class="panel">
  <div class="panel-header"><span class="collapse-dot">&minus;</span> <span class="panel-icon">&#128683;</span> Deleted Citations</div>
  <div class="panel-body empty">No data available in table.</div>
</div>

<%- include('../partials/bottom') %>
