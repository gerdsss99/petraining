<%- include('../partials/top') %>

<%
  var prefillReason = '';
  var prefillAmount = '';
  if (infraction && infraction.codes.length) {
    prefillReason = infraction.codes[0].reasonText || infraction.codes[0].codeLabel;
    prefillAmount = infraction.codes[0].fineAmount || '';
  }
%>

<div class="modal-overlay">
  <div class="modal-card modal-card-narrow">
    <div class="modal-card-header">
      Issue Citation
      <a href="<%= infraction ? ('/person/' + person.id + '/infractions/' + infraction.id) : ('/person/' + person.id) %>" class="modal-close" title="Close">&times;</a>
    </div>
    <div class="modal-card-body">
      <% if (infraction) { %>
        <p class="text-muted">Linked to <a href="/person/<%= person.id %>/infractions/<%= infraction.id %>">Infraction Report #<%= infraction.id %></a> — <%= person.firstName %> <%= person.lastName %>.</p>
      <% } else { %>
        <p class="text-muted">For <%= person.firstName %> <%= person.lastName %>.</p>
      <% } %>
      <% if (error) { %><div class="search-error">&#9888; <%= error %></div><% } %>

      <form method="POST" action="/person/<%= person.id %>/citations" id="citationForm">
        <% if (infraction) { %><input type="hidden" name="infractionId" value="<%= infraction.id %>"><% } %>
        <div class="form-grid">
          <div class="form-group">
            <label>Amount ($)</label>
            <input type="number" name="amount" min="1" required value="<%= prefillAmount %>">
          </div>
          <div class="form-group">
            <label>Reason</label>
            <input type="text" name="reason" required placeholder="e.g. IC 410 — Speeding" value="<%= prefillReason %>">
          </div>
          <div class="form-group">
            <label>Vehicle Plate (optional)</label>
            <input type="text" name="vehiclePlate" list="person-plate-options" placeholder="e.g. TRN001">
            <datalist id="person-plate-options">
              <% person.vehicles.forEach(function(v){ %><option value="<%= v.plate %>"><% }); %>
            </datalist>
          </div>
          <div class="form-group">
            <label>Street Name (optional)</label>
            <input type="text" name="streetName" placeholder="e.g. Innocence Boulevard">
          </div>
        </div>
      </form>
    </div>
    <div class="modal-card-footer">
      <a class="btn btn-outline" href="<%= infraction ? ('/person/' + person.id + '/infractions/' + infraction.id) : ('/person/' + person.id) %>">Cancel</a>
      <button type="submit" form="citationForm" class="btn">Issue Citation</button>
    </div>
  </div>
</div>

<%- include('../partials/bottom') %>
