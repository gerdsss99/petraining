<%- include('../partials/top') %>

<div class="modal-overlay">
  <div class="modal-card">
    <div class="modal-card-header">
      Infraction Report #<%= infraction.id %> &mdash;
      <a href="/person/<%= infraction.personId %>"><%= infraction.personFirstName %> <%= infraction.personLastName %></a>
      <a href="/person/<%= infraction.personId %>" class="modal-close" title="Close">&times;</a>
    </div>
    <div class="modal-card-body">
      <div class="infraction-meta-grid">
        <div><span class="text-muted">Status</span><br><span class="status-pill <%= infraction.status.toLowerCase() %>"><%= infraction.status %></span></div>
        <div><span class="text-muted">Confidential Level</span><br><%= infraction.confidentialLevel %></div>
        <div><span class="text-muted">Location</span><br><%= infraction.location || '—' %></div>
        <div><span class="text-muted">Reported By</span><br><%= infraction.reportedBy || '—' %></div>
        <div><span class="text-muted">Timestamp</span><br><%= infraction.timestamp.toLocaleString() %></div>
      </div>

      <h4 class="section-subhead">Narrative</h4>
      <div class="narrative-box"><%- infraction.narrative || 'No narrative provided.' %></div>

      <h4 class="section-subhead">Evidence</h4>
      <% if (!infraction.evidenceList.length) { %>
        <div class="panel-body empty" style="padding:0 0 12px;">No evidence uploaded.</div>
      <% } else { %>
        <div class="evidence-gallery">
          <% infraction.evidenceList.forEach(function(url){ %>
            <a href="<%= url %>" target="_blank" rel="noopener"><img src="<%= url %>" alt="Evidence" onerror="this.style.display='none'"></a>
          <% }); %>
        </div>
      <% } %>
    </div>
    <div class="modal-card-footer">
      <a class="btn btn-outline" href="/person/<%= infraction.personId %>">Back to Profile</a>
    </div>
  </div>
</div>

<%- include('../partials/bottom') %>
