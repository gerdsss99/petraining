<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Change Password &middot; <%= appName %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="login-wrap">
    <div class="password-card">
      <h1><%= forced ? 'Set Your Password' : 'Change Password' %></h1>
      <% if (forced) { %>
        <div class="training-banner">&#9888; This account was just created with a one-time temporary password. Set your
          own password below before continuing &mdash; there's no way to skip this step.</div>
      <% } else { %>
        <p class="login-form-hint">Update the password for your account.</p>
      <% } %>

      <% if (error) { %>
        <div class="login-error"><%= error %></div>
      <% } %>

      <form method="POST" action="/change-password">
        <div class="form-group">
          <label for="currentPassword"><%= forced ? 'Temporary Password' : 'Current Password' %></label>
          <input type="password" id="currentPassword" name="currentPassword" required autofocus autocomplete="current-password">
        </div>
        <div class="form-group">
          <label for="newPassword">New Password</label>
          <input type="password" id="newPassword" name="newPassword" required minlength="6" autocomplete="new-password">
        </div>
        <div class="form-group">
          <label for="confirmPassword">Confirm New Password</label>
          <input type="password" id="confirmPassword" name="confirmPassword" required minlength="6" autocomplete="new-password">
        </div>
        <button type="submit" class="btn" style="width:100%;">Set New Password</button>
      </form>

      <% if (!forced) { %>
        <div class="login-demo-hint"><a href="/">&larr; Back to Dashboard</a></div>
      <% } %>
    </div>
  </div>
</body>
</html>
