<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> &middot; <%= appName %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="sidebar-brand"><%= appName %></div>
      <div class="sidebar-seal">
        <img src="/img/seal.svg" alt="<%= cityName %> seal">
      </div>
      <ul class="sidebar-nav">
        <li><a href="/" class="<%= currentPath === '/' ? 'active' : '' %>"><span class="nav-icon">&#9638;</span> Dashboard</a></li>

        <li class="nav-group-label">Person Database</li>
        <li><a class="sub <%= currentPath.startsWith('/person') ? 'active' : '' %>" href="/person"><span class="nav-icon">&#128100;</span> Person Lookup</a></li>
        <li><a class="sub <%= currentPath.startsWith('/dmv') ? 'active' : '' %>" href="/dmv"><span class="nav-icon">&#128663;</span> DMV Database</a></li>

        <li>
          <a href="/wanted" class="nav-parent <%= currentPath.startsWith('/wanted') ? 'active' : '' %>">
            <span class="nav-icon">&#9873;</span> Wanted Database <span class="nav-caret">&#8250;</span>
          </a>
        </li>
        <li>
          <a href="/maps" class="nav-parent <%= currentPath.startsWith('/maps') ? 'active' : '' %>">
            <span class="nav-icon">&#8982;</span> Maps <span class="nav-caret">&#8250;</span>
          </a>
        </li>
        <li>
          <a href="/miscellaneous" class="nav-parent <%= currentPath.startsWith('/miscellaneous') ? 'active' : '' %>">
            <span class="nav-icon">&#9881;</span> Miscellaneous <span class="nav-caret">&#8250;</span>
          </a>
        </li>

        <% if (currentUser && currentUser.role === 'admin') { %>
          <li class="nav-group-label">Administration</li>
          <li><a href="/admin" class="<%= currentPath.startsWith('/admin') ? 'active' : '' %>"><span class="nav-icon">&#9873;</span> Admin Panel</a></li>
        <% } %>
      </ul>
      <ul class="sidebar-nav sidebar-nav-bottom">
        <li><a href="/changelog" class="<%= currentPath.startsWith('/changelog') ? 'active' : '' %>"><span class="nav-icon">&lt;/&gt;</span> Changelog</a></li>
      </ul>
    </aside>

    <div class="main">
      <div class="topbar">
        <div class="topbar-left">
          <% if (currentUser) { %>
            <span class="topbar-role"><%= currentUser.employee ? currentUser.employee.rankTitle || 'Staff' : (currentUser.role === 'admin' ? 'Administrator' : 'Staff') %>
              &mdash; <%= currentUser.employee ? currentUser.employee.firstName + ' ' + currentUser.employee.lastName : currentUser.username %></span>
            <span class="badge-id">#<%= currentUser.employee ? currentUser.employee.badgeNumber : currentUser.id %></span>
          <% } %>
        </div>

        <div class="topbar-center"><%= serverTime %></div>

        <div class="topbar-right">
          <form class="topbar-search" method="GET" action="/person">
            <button type="submit" class="topbar-search-icon" title="Search Person">&#128269;</button>
            <input type="text" name="q" placeholder="Search Person">
          </form>
          <form class="topbar-search" method="GET" action="/dmv">
            <button type="submit" class="topbar-search-icon" title="Search Vehicle">&#128269;</button>
            <input type="text" name="q" placeholder="Search Vehicle">
          </form>
          <a class="icon-btn" title="Person Lookup" href="/person">&#128269;</a>
          <button type="button" class="icon-btn" title="Recent activity">&#8635;</button>
          <button type="button" class="icon-btn" title="Notifications">&#128276;</button>
          <button type="button" class="icon-btn" title="Menu">&#9776;</button>
          <% if (currentUser) { %>
            <form method="POST" action="/logout">
              <button type="submit" class="logout-btn">Log out</button>
            </form>
          <% } %>
        </div>
      </div>

      <div class="content">
