{
  "name": "mdc-training-replica",
  "version": "1.0.0",
  "description": "Training replica of a roleplay server Mobile Data Computer (MDC). Not affiliated with, and not a copy of, any real government system.",
  "private": true,
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "db:migrate": "node src/lib/migrate.js",
    "db:seed": "node sql/seed.js",
    "db:setup": "node src/lib/migrate.js && node sql/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^9.0.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "method-override": "^3.0.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
