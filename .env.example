# Copy this file to .env and adjust before deploying the stack.
# In Portainer: Stacks -> your stack -> Environment variables (you can paste
# these in directly instead of using a .env file).

POSTGRES_USER=mdc
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=mdc_training

# Long random string — used to sign session cookies.
SESSION_SECRET=change-this-to-a-long-random-string

APP_NAME=Mobile Data Computer
CITY_NAME=City of Training

# Port on the HOST machine that maps to the app's internal port 3000.
HOST_PORT=8080

# Set to "false" after the first run if you don't want the demo data
# re-seeded every time the container restarts.
SEED_ON_START=true

# --- Only needed if you're putting Apache/nginx in front of this (see README) ---

# Set to "true" when a reverse proxy (Apache/nginx) is terminating HTTPS in
# front of this app. Enables secure session cookies.
TRUST_PROXY=false

# Once a reverse proxy is in front, bind the container's port to localhost
# only so the app can't be reached directly on HOST_PORT, bypassing the
# proxy/HTTPS. Leave as 0.0.0.0 until your reverse proxy is working.
BIND_ADDRESS=0.0.0.0
